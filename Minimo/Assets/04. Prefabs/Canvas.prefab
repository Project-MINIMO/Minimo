  m_text: "{\uBBF8\uB2C8\uBAA8 \uD0C4\uC0DD\uBCC4} \uC5D0\uC11C \uD0DC\uC5B4\uB0AC\uB2E4.\n\n\uBBF8\uB2C8\uBAA8
    \uC124\uBA85\uD558\uB098\uB458\uC14B\uB137\uB2E4\uC12F\uC5EC\uC12F\n\uB3D9\uD574\uBB3C\uBD10
